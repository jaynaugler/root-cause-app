# Shared by all consumers: web (vite envDir), api (pydantic-settings), and the seed script (dotenv).
MONGODB_URI=""
MONGODB_DB=""
ATLAS_URI=""
ATLAS_DB=""
# ZenRows relay key for api/app/egress.py (Render's IP gets blocked when
# scraping feeds / Gutenberg / PDF hosts). Unset = direct requests, which is
# what dev machines want — set it only in Render's environment so credits are
# not spent on local runs.
ZENROWS_API_KEY=""

# Google AI Studio key for api/app/ai.py (PDF record cleanup); unset = raw records.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT="30"

# search-server/search-api (semantic search + summary). URL without /api/search.
SEARCH_API_URL=""
SEARCH_API_KEY=""